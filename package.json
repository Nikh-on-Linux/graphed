{
  "name": "graphed",
  "version": "1.0.0",
  "description": "",
  "main": "main/dist/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:renderer": "cd renderer && next dev",
    "dev:main": "tsc -p main -w",
    "dev:electron": "wait-on http://localhost:3000 && nodemon --watch main/dist --exec \"electron main/dist/main.js\"",
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "build:renderer": "cd renderer && next build",
    "build:main": "tsc -p main",
    "build": "npm run build:renderer && npm run build:main"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  }
}
